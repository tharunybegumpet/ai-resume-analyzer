{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ai-resume-analyzer-production-1453.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist"
}
